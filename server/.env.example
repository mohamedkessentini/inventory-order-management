# Copy to .env and adjust. Never commit the real .env file.

NODE_ENV=development
PORT=4100

# MongoDB connection. 27019 is the host port used by docker-compose (mapped to the
# container's default 27017) to avoid clashing with any MongoDB already running locally.
MONGO_URI=mongodb://localhost:27019/inventory_management

# Generate a real secret for anything beyond local dev, e.g.: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# Must match the frontend's origin for CORS.
CORS_ORIGIN=http://localhost:4200
